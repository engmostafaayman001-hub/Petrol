SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO_STATION_ID=11111111-1111-4111-111111111111
# ---------------------------------------------------------------------------
# Supabase — project connection
# ---------------------------------------------------------------------------
# Found under: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used exclusively by:
#   - the user provisioning service (manager creates/disables accounts)
#   - the sensor ingestion endpoint (machine-to-machine, no user session)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Sensor gateway (future hardware integration)
# ---------------------------------------------------------------------------
# Shared secret presented by the on-site sensor gateway as the
# `x-gateway-key` header on POST /api/sensors/readings.
# Leave empty to keep the ingestion endpoint disabled (returns 503).
SENSOR_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Absolute origin, used for auth redirects and absolute links in exports.
NEXT_PUBLIC_APP_URL=http://localhost:3000
